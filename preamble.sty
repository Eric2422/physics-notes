%% Custom commands
\newcommand{\titlePage}[2]{
    \begin{titlepage}
        \centering
        \doublespacing

        \Huge
        \textbf{Physics Notes} \\
        \vspace{0.5cm}

        \huge
        Volume #1: #2 \\
        \vfill

        \LARGE
        Eric Zhang \\
        \vfill

        \Large
        \url{https://github.com/Eric2422/physics-notes} \\
        \today
    \end{titlepage}
}

% Reference number, name, and page number.
\newcommand{\nameRef}[1]{\Cref*{#1}:~\nameref{#1} (\cpageref{#1})}
% Reference equation with page number
\newcommand{\eqPgRef}[1]{\cref{#1} (\cpageref{#1})}

