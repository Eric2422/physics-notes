% Create custom title page.
\newcommand{\titlePage}[2]{
    \begin{titlepage}
        \centering
        \doublespacing

        \Huge
        \textbf{Physics Notes} \\
        \huge
        Volume #1: #2 \\
        \vfill

        \LARGE
        Eric Zhang \\
        \vfill

        \Large
        \url{https://github.com/Eric2422/physics-notes} \\
        \today
    \end{titlepage}
}
\newcommand{\backToContents}{
    \noindent
    Back to \hyperref[contents]{Contents}
}

% List math sections.
\newcommand{\mathTopics}[1]{Recommended mathematical topics:~#1}
% Cross reference with page number.
\newcommand{\pgRef}[1]{\cref{#1}~(\cpageref{#1})}
% Cross reference with page number but sentence-initial.
\newcommand{\PgRef}[1]{\Cref{#1}~(\cpageref{#1})}

% Vector bold.
\newcommand{\vecb}[1]{\bm{\mathrm{#1}}}
% Matrix bold.
\newcommand{\mat}[1]{\underline{#1}}
\newcommand{\matb}[1]{\bm{\mathrm{#1}}}

\renewcommand{\Re}{\operatorname{Re}}
\renewcommand{\Im}{\operatorname{Im}}

% Make curly epsilon default.
\let\temp\epsilon
\let\epsilon\varepsilon
\let\varepsilon\temp
