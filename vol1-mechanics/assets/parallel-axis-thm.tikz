\begin{tikzpicture}
    \draw (-6, -0.3) rectangle (6, 0.3);
    \draw[{|[scale=2]}-{|[scale=2]}] (-6, -0.667) -- (6, -0.667)
    node[midway, below] {\(\ell\)};
    \node [
        circle,
        fill=black,
        text=black,
        minimum size=0.0mm,
        inner sep=0.75mm
